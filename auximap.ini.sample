; auximap.ini 設定ファイル
; ==============================================================================
; 【重要・文字コードの注意】
; この ini ファイルの文字コードは「UTF-8」で保存してください！
; ※PPx の設定ファイル（.cfg = UTF-16LE）とは異なり、ini は UTF-8 です。
;   UTF-16 や Shift-JIS (ANSI) で保存するとツールが起動できなくなります。
; ==============================================================================
; このファイルをコピーして「auximap.ini」という名前で auximap.exe と同じフォルダに配置してください。

[DEFAULT]
; 一覧表示時に取得する直近の最大メール件数（新しい順。1000〜5000なども指定可能）
limit = 100
; 取得開始オフセット（スキップ件数。最新から数えて何通目から取得するか。既定: 0）
; 例: 3000 に設定すると、最新から3000件スキップした位置から limit 件を取得
offset = 0
; 分割取得件数（0 または未指定: 一括取得。250などの数値を指定: 常時分割取得）
; コマンドラインで --chunk を付けた場合は引数が最優先されます
chunk_size = 0
; デフォルトのゴミ箱フォルダ名
trash_folder = Trash
; 日時表示のタイムゾーン設定（local: PCの日本時間に自動換算[推奨・既定], server: サーバー時間そのまま, utc: UTC協定世界時）
timezone = local
; 日時表示の取得元（internal: サーバー受信日時[推奨・既定], header: メールの送信日時Date:）
date_source = internal

; ==============================================================================
; メール本文表示（read サブコマンド）のフォーマット設定
; ==============================================================================
[VIEW]
; 外部テンプレートファイルのパス（相対パスまたは絶対パス）
; 未指定の場合は auximap.exe と同じフォルダの view_template.txt を自動使用
template_file = view_template.txt

; HTML専用メールの表示ポリシー:
;   text: HTMLタグを除去し整形テキストとして抽出表示（推奨・既定）
;   raw : 生のHTMLのまま表示
html_policy = text

; ==============================================================================
; 【パスワードの設定方法】
; ==============================================================================
; [標準運用: PPx 標準ダイアログ / メモリ管理（推奨）]
;   pass = （空欄にしておく）
;   -> auximap.cfg で --pass="%*pass" が指定されているため、PPx が初回のみパスワード入力を
;      促し、セッション中安全にメモリ保持します。ホストPCに一切資格情報の痕跡を残しません。
;
; [テスト・検証用: ini ファイルに直接記述]
;   pass = your_password
;   -> 初期設定時の接続テストや、サンプルの Emacs 連携（auximap.el）で簡易動作確認を
;      行いたい場合に使用します（常用時は空欄にして PPx ダイアログ運用を推奨）。
; ==============================================================================

; ==============================================================================
; 【ドメイン自動解決ルール（Auto-configuration）】
; ==============================================================================
; [RULE:<domain_pattern>] を定義しておくと、個別アカウントで `user = ...`
; （メールアドレス）を書くだけで、host / port / ssl / trash_folder が自動補完されます。
; 個別セクションで明示的に指定した項目は、常に 100% 最優先で上書きされます。
; テンプレート変数: {domain} = メールアドレスのドメイン, {user_part} = @より前の部分
;
; ※Gmail, Yahoo!, さくら(*.sakura.ne.jp), Outlook, iCloud は組み込みルールが内蔵されているため、
;   下記の [RULE:...] を書かなくても自動補完されます。独自ドメインや設定を上書きしたい場合にご使用ください。

;[RULE:gmail.com]
;host = imap.gmail.com
;port = 993
;ssl = true
;trash_folder = [Gmail]/ゴミ箱

;[RULE:*.sakura.ne.jp]
;host = {domain}
;port = 993
;ssl = true
;trash_folder = Trash

;[RULE:yahoo.co.jp]
;host = imap.mail.yahoo.co.jp
;port = 993
;ssl = true
;trash_folder = Trash

;[RULE:DEFAULT]
;host = mail.{domain}
;port = 993
;ssl = true
;trash_folder = Trash

; ==============================================================================
; 【重要: アカウント名（セクション名）の命名規則】
; セクション名（例: [sakura], [gmail], [work]）は、PPc 上で仮想フォルダ名
; としてそのまま画面表示・パス構築に使用されます。
; そのため、セクション名にメールアドレスそのもの（@ や . を含む文字列）を書くのではなく、
; Windows のフォルダ名として安全な「半角英数字（ハイフンやアンダースコア可）」を指定してください。
; ※メールアドレス自体は、各セクション内の `user = ...` に記述します。
; ==============================================================================

; ------------------------------------------------------------------
; さくらのメール設定例
; ※さくらの初期ドメイン（*.sakura.ne.jp）の場合、host や trash_folder は
;   ドメインルールにより自動解決されるため、user を書くだけで接続可能です！
; ------------------------------------------------------------------
[sakura]
; 独自ドメイン等の場合は明示的に host を指定（指定項目が最優先されます）
host = example.sakura.ne.jp
port = 993
user = info@example.sakura.ne.jp
; 通常（PPx連携）は空欄のまま。接続テストやサンプルEmacs利用時のみ記述可能
pass = 
ssl = true
trash_folder = Trash
limit = 150

; ------------------------------------------------------------------
; Gmail 設定例
; ※host や trash_folder は自動補完されるため、user とアプリパスワードだけでも利用可能
; ※Google アカウント設定 > セキュリティ > 2段階認証 > アプリ パスワード（16桁）を使用
; ------------------------------------------------------------------
[gmail]
host = imap.gmail.com
port = 993
user = your_address@gmail.com
pass = abcd efgh ijkl mnop
ssl = true
trash_folder = [Gmail]/ゴミ箱
limit = 100

; ------------------------------------------------------------------
; Yahoo! メール 設定例
; ※Yahoo! JAPAN IDの「IMAP/POP/SMTPアクセス」設定を有効にしてください
; ------------------------------------------------------------------
;[yahoo]
;host = imap.mail.yahoo.co.jp
;port = 993
;user = your_id@yahoo.co.jp
;pass = your_password
;ssl = true
;trash_folder = Trash

; ------------------------------------------------------------------
; Outlook / Hotmail / Microsoft 365 設定例
; ------------------------------------------------------------------
;[outlook]
;host = outlook.office365.com
;port = 993
;user = your_address@outlook.com
;pass = your_password
;ssl = true
;trash_folder = Deleted

; ------------------------------------------------------------------
; iCloud メール（Apple）設定例
; ※Apple ID 管理画面（appleid.apple.com）で生成した「App用パスワード」を使用
; ------------------------------------------------------------------
;[icloud]
;host = imap.mail.me.com
;port = 993
;user = your_id@icloud.com
;pass = abcd-efgh-ijkl-mnop
;ssl = true
;trash_folder = Deleted Messages

; ------------------------------------------------------------------
; 自社ドメイン / エックスサーバー / ロリポップ等の設定例
; ------------------------------------------------------------------
;[work]
;host = mail.example.com
;port = 993
;user = user@example.com
;pass = your_password
;ssl = true
;trash_folder = Trash

; ------------------------------------------------------------------
; 過去メール閲覧用のアカウント設定例（セクション分割）
; 同じメールアドレスで別セクションを作成し offset を指定することで、
; PPc 上に「過去メール専用の仮想フォルダ」として並べることができます。
; ------------------------------------------------------------------
;[sakura_past]
;user = info@example.sakura.ne.jp
;limit = 100
;offset = 3000   ; 最新から3000通スキップした位置から取得

